@startuml
title AD-03 — Reset, Konfirmasi, dan Ubah Password
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activityBorderColor #0284C7
skinparam activityBackgroundColor #F0F9FF
skinparam ArrowColor #334155

|#E8F4FF|User|
start
:Pilih aksi password;

|#ECFDF5|HEALO Application|
if (Lupa password?) then (Ya)
  |#E8F4FF|User|
  :Masukkan email;
  |#ECFDF5|HEALO Application|
  :Validasi email dan kirim respons generik;
  |#FFF7E6|Database|
  if (Akun ditemukan?) then (Ya)
    :Buat / perbarui reset token;
    |#F3E8FF|Mail Transport|
    :Kirim tautan reset;
    |#E8F4FF|User|
    :Buka tautan dan isi password baru;
    |#ECFDF5|HEALO Application|
    :Validasi token, email,\ndan konfirmasi password;
    if (Token dan data valid?) then (Ya)
      |#FFF7E6|Database|
      :Hash dan simpan password baru;
      :Hapus / invalidasi reset token;
      |#ECFDF5|HEALO Application|
      :Tampilkan reset berhasil;
    else (Tidak)
      :Tampilkan token tidak valid / kedaluwarsa;
    endif
  else (Tidak)
    |#ECFDF5|HEALO Application|
    :Pertahankan respons generik;
  endif
else (Tidak)
  |#E8F4FF|User|
  :Masukkan current password\ndan password baru;
  |#ECFDF5|HEALO Application|
  :Konfirmasi password aktif\ndan validasi password baru;
  if (Valid?) then (Ya)
    |#FFF7E6|Database|
    :Simpan hash password baru;
    |#ECFDF5|HEALO Application|
    :Tampilkan perubahan berhasil;
  else (Tidak)
    :Tampilkan validation error;
  endif
endif
stop
@enduml

