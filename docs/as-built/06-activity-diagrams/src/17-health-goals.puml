@startuml
title AD-17 — Mengelola dan Memantau Health Goal
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activityBorderColor #0F766E
skinparam activityBackgroundColor #F0FDFA
skinparam ArrowColor #334155

|#E8F4FF|User|
start
:Buka Health Goals;
:Pilih buat, ubah, lihat progress,\natau hapus goal;

|#ECFDF5|HEALO Application|
if (Buat / ubah?) then (Ya)
  |#E8F4FF|User|
  :Isi type, target, unit,\nstart date, target date, status;
  |#ECFDF5|HEALO Application|
  :Validasi enum, range, tanggal,\ndan ownership untuk update;
  if (Valid?) then (Tidak)
    :Tampilkan validation errors;
    stop
  else (Ya)
    |#FFF7E6|Database|
    :Simpan HealthGoal;
  endif
elseif (Hapus?) then (Ya)
  |#ECFDF5|HEALO Application|
  :Periksa ownership;
  if (Milik User?) then (Ya)
    |#FFF7E6|Database|
    :Hapus goal dan simpan audit;
  else (Tidak)
    |#ECFDF5|HEALO Application|
    :Tolak akses;
    stop
  endif
else (Lihat progress)
endif

|#FFF7E6|Database|
:Ambil source sesuai goal type:\nBMI, berat, meal, atau jurnal;

|#ECFDF5|HEALO Application|
:Hitung current value, remaining,\npercentage, unit, dan status;
:Perbarui current_value / status bila perlu;

|#E8F4FF|User|
:Lihat progress goal;
stop
@enduml

